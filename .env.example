# GeniusYield Fill Bot — config
# Copy to .env and fill in your values.

# ── GY API endpoint ───────────────────────────────────────────────
GY_API_URL=https://api.prod.geniusyield.co
GY_API_KEY=

# ── Trading pair the bot watches ──────────────────────────────────
# Cardano asset IDs in fingerprint form (asset1...).
BASE_ASSET_ID=asset1xdz4yj4ldwlpsz2yjgjtt9evg9uskm8jrzjwhj
QUOTE_ASSET_ID=asset1266q2ewhgul7jh3xqpvjzqarrepfjuler20akr

# ── Wallet ────────────────────────────────────────────────────────
# Bech32 mnemonic seed for a HOT wallet only. Never put treasury funds here.
# To generate: lucid-evolution's Wallet.generateSeed() or any Cardano wallet's "show recovery phrase".
WALLET_SEED="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# ── Cardano node / chain backend ──────────────────────────────────
# Blockfrost is the simplest. Maestro or Koios work too.
BLOCKFROST_API_KEY=mainnet...
NETWORK=Mainnet

# ── Bot tuning ────────────────────────────────────────────────────
# Polling cadence. Cardano blocks are ~20s — anything tighter than 5s wastes calls.
POLL_INTERVAL_MS=8000

# Minimum spread (basis points) we need to capture above ALL costs to attempt a fill.
# 50 bps = 0.5%. Lower = more attempts, more failed/marginal. Higher = fewer but safer.
MIN_PROFIT_BPS=50

# Hard cap on the size of any single fill, in base-asset indivisible units. Stops a runaway
# strategy from blowing the wallet on one bad quote.
MAX_FILL_BASE=200000000

# Dry-run mode: prints what the bot would do without sending any tx. Useful for first-run smoke tests.
DRY_RUN=false

# ── AMM source ────────────────────────────────────────────────────
# `mock`: returns a fixed price (0). Bot will never see a profitable arb.
#         Use for first-run smoke tests with a real wallet.
# `dexhunter`: pulls real prices from DexHunter's /swap/estimate aggregator.
#              Required for any real deployment.
AMM_SOURCE=mock

# DexHunter partner API key. Required if AMM_SOURCE=dexhunter.
# Get one at the DexHunter developer portal.
DEXHUNTER_API_KEY=

# ── Prometheus metrics ────────────────────────────────────────────
# Port the bot exposes /metrics + /healthz on. K8s probes hit /healthz.
METRICS_PORT=9100

# ── Heartbeat / Leaderboard reporting ─────────────────────────────
# Every minute the bot publishes a signed snapshot of its 24h stats to
# GeniusYield's POST /v1/bot/heartbeat so the public Leaderboard shows
# live fills/PnL/inventory. The api-server verifies the Ed25519 signature
# and cross-checks against on-chain activity before accepting numbers.
#
# Set HEARTBEAT_ENABLED=false to disable (private/anonymous operation).
HEARTBEAT_ENABLED=true

# The TradingWallet you registered on https://app.geniusyield.co/leaderboard
# (the "Register Bot" dialog returns this UUID).
TRADING_WALLET_ID=

# The PRIVATE half of your operator Ed25519 keypair, 32 bytes hex.
# Generate one with: `node dist/keygen.js` — it prints both halves.
# Register the PUBLIC half with your TradingWallet record (one-time).
# Keep the PRIVATE key in your host's secret store; never commit.
OPERATOR_PRIVATE_KEY_HEX=

# How often to publish a heartbeat. 60_000 = once per minute.
HEARTBEAT_INTERVAL_MS=60000

# Reported as `version` field of the heartbeat payload so operators can
# see in the leaderboard which bot version each operator is running.
BOT_VERSION=0.1.0
